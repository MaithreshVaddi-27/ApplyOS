{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "bun run .agents/skills/*", "effect": "allow" },
    { "action": "shell", "resource": "python tools/rank_state.py *", "effect": "allow" },
    { "action": "shell", "resource": "python3 tools/rank_state.py *", "effect": "allow" },
    { "action": "shell", "resource": "python tools/verify_pdf.py *", "effect": "allow" },
    { "action": "shell", "resource": "python3 tools/verify_pdf.py *", "effect": "allow" },
    { "action": "shell", "resource": "python salary_lookup.py *", "effect": "allow" },
    { "action": "shell", "resource": "python3 salary_lookup.py *", "effect": "allow" },
    { "action": "shell", "resource": "pdftotext *", "effect": "allow" }
  ]
}
